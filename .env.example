# Rocket.Chat
# Required: Base URL of the Rocket.Chat server.
ROCKETCHAT_URL=http://localhost:3000

# Optional: Personal Access Token; used with ROCKETCHAT_USER_ID when set.
ROCKETCHAT_AUTH_TOKEN=your-rocketchat-auth-token
# Optional: User ID paired with ROCKETCHAT_AUTH_TOKEN.
ROCKETCHAT_USER_ID=your-rocketchat-user-id
# Optional: Agent username; used when the Personal Access Token pair is empty.
ROCKETCHAT_AGENT_USERNAME=your-agent-username
# Optional: Agent password; used when the Personal Access Token pair is empty.
ROCKETCHAT_AGENT_PASSWORD=your-agent-password
# Optional: Department ID used to assign visitors; default is empty.
ROCKETCHAT_DEPARTMENT_ID=
# Optional: Log polling-history requests when true; default is false.
DEBUG_POLLING=false
# Optional: Dump selected raw Rocket.Chat/Telegram media payloads; default is false.
DEBUG_DUMP_PAYLOADS=false
# Dumps are written to ./debug-dumps/ and must not be committed.

# Facebook Messenger
# Optional: Page Access Token; required when Facebook integration is enabled.
FB_PAGE_ACCESS_TOKEN=your-facebook-page-access-token
# Optional: Facebook Page ID; currently unused by the code.
FB_PAGE_ID=your-facebook-page-id
# Optional: Webhook verification token; required when Facebook webhooks are enabled.
FB_VERIFY_TOKEN=your-facebook-webhook-verify-token

# Telegram
# Optional: Bot token from BotFather; required when Telegram integration is enabled.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional: Use local getUpdates polling instead of a webhook; default is false.
TELEGRAM_POLLING=false
# Optional: Telegram polling interval in milliseconds; default is 2000.
TELEGRAM_POLL_INTERVAL_MS=2000
# Optional: Maximum accepted Telegram document size in bytes; default is 104857600.
TELEGRAM_MAX_DOCUMENT_BYTES=104857600

# AI bot
# Optional: Enable automatic AI replies; default is false.
AI_ENABLED=false
# Optional: OpenAI-compatible API key; required when AI_ENABLED is true.
AI_API_KEY=your-ai-api-key
# Optional: OpenAI-compatible API base URL; default is https://api.openai.com/v1.
AI_BASE_URL=https://api.openai.com/v1
# Optional: AI model name; code default is gpt-4o-mini.
AI_MODEL=deepseek-reasoner
# Optional: Business facts available to the AI; default is empty.
AI_BUSINESS_CONTEXT=Business name: ...; Products/services: ...; Opening hours: ...; Support email: ...
# Optional: Message sent when the AI hands a conversation to an agent; default is defined in constants/messages.js.
AI_HANDOFF_MESSAGE=I do not have enough information to answer accurately. I have forwarded your message to a support agent. Please wait a moment.

# Documents and RAG
# Optional: Express request body limit; code default is 2mb.
REQUEST_BODY_LIMIT=100mb
# Optional: Document chunk size; default is 1200.
DOCUMENT_CHUNK_SIZE=1200
# Optional: Document chunk overlap; default is 150.
DOCUMENT_CHUNK_OVERLAP=150
# Optional: Number of document chunks retrieved per query; default is 4.
DOCUMENT_TOP_K=4
# Optional: Number of document chunks used for summaries; default is 8.
DOCUMENT_SUMMARY_TOP_K=8

# Runtime
# Optional: Default outbound HTTP timeout in milliseconds; default is 15000.
HTTP_TIMEOUT_MS=15000
# Optional: Outbound upload HTTP timeout in milliseconds; default is 120000.
HTTP_UPLOAD_TIMEOUT_MS=120000
# Optional: Server port; default is 3000.
PORT=3000
# Optional: Server timezone; default is Asia/Bangkok, which has the same UTC offset as Vietnam.
TZ=Asia/Bangkok
