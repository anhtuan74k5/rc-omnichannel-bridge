# ===== Rocket.Chat =====
# Base URL of Rocket.Chat server (only /api/v1/livechat/* routes are allowed)
ROCKETCHAT_URL=https://dev.weteams.net

# Option A: Personal Access Token from Rocket.Chat Account -> Personal Access Tokens.
# If both values are set, the bridge uses these instead of username/password.
ROCKETCHAT_AUTH_TOKEN=
ROCKETCHAT_USER_ID=

# Option B: Agent account (NOT admin) used to login and get X-Auth-Token / X-User-Id.
# Used only when ROCKETCHAT_AUTH_TOKEN / ROCKETCHAT_USER_ID are empty.
ROCKETCHAT_AGENT_USERNAME=
ROCKETCHAT_AGENT_PASSWORD=
# Optional: department id to assign visitors to
ROCKETCHAT_DEPARTMENT_ID=

# ===== Facebook Messenger =====
# Page Access Token (from Facebook App -> Messenger -> Settings -> Access Tokens)
FB_PAGE_ACCESS_TOKEN=
# Page ID of your Facebook Page
FB_PAGE_ID=
# Verify token you set in Facebook App webhook settings (must match exactly)
FB_VERIFY_TOKEN=

# ===== Telegram =====
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Optional local testing mode: receive Telegram messages without ngrok/webhook.
TELEGRAM_POLLING=false
TELEGRAM_POLL_INTERVAL_MS=2000
# Max document size accepted from Telegram uploads.
TELEGRAM_MAX_DOCUMENT_BYTES=104857600

# ===== AI Bot (optional) =====
# Set AI_ENABLED=true to let the AI auto-reply to simple questions before
# handing off to a human agent. Uses an OpenAI-compatible Chat Completions API.
AI_ENABLED=false
AI_API_KEY=

# Optional: override API base URL (e.g. local LLM, Azure, Groq)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=deepseek-reasoner
# Optional facts the bot is allowed to use about your business.
AI_BUSINESS_CONTEXT=Tên doanh nghiệp: ...; Sản phẩm/dịch vụ: ...; Giờ làm việc: ...; Email hỗ trợ: ...
# Message sent to the customer when AI cannot answer and the room is handed to an agent.
AI_HANDOFF_MESSAGE=Mình chưa có đủ thông tin để trả lời chính xác câu hỏi này. Mình đã chuyển nội dung cho nhân viên hỗ trợ, bạn vui lòng chờ trong giây lát nhé.

# ===== Documents / RAG (optional) =====
# Uploaded documents are stored locally in data/documents/<platform>_<platformUserId>.
REQUEST_BODY_LIMIT=100mb
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_TOP_K=4
DOCUMENT_SUMMARY_TOP_K=8

# ===== Server =====
PORT=3000

